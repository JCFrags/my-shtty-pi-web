#!/usr/bin/env python3
"""Print or check one composable Pi Web installation profile plan."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import sys

from pi_web_profiles import PROFILE_IDS, resolve_profiles


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--profile", action="append", choices=PROFILE_IDS, dest="profiles")
    parser.add_argument("--check", action="store_true", help="Check command dependencies without changing the host.")
    args = parser.parse_args()
    plan = resolve_profiles(args.source.resolve(strict=True), args.profiles)
    checks = [{"command": command, "ok": shutil.which(command) is not None} for command in plan["commands"]]
    plan["dependencyChecks"] = checks
    plan["ok"] = all(check["ok"] for check in checks) if args.check else True
    print(json.dumps(plan, sort_keys=True, indent=2))
    return 0 if plan["ok"] else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"pi-web-profile: {error}", file=sys.stderr)
        raise SystemExit(2)
