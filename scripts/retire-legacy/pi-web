#!/usr/bin/env bash
set -euo pipefail
root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
case "${1:-}" in
  doctor) shift; exec /usr/bin/node "$root/doctor.mjs" "$@" ;;
  audit) shift; exec /usr/bin/node "$root/audit.mjs" "$@" ;;
  status) shift; exec /usr/bin/systemctl --user status webxd pi-web-reader pi-web-searxng "$@" ;;
  *) echo 'usage: pi-web {doctor|audit|status}' >&2; exit 2 ;;
esac
