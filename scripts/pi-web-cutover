#!/usr/bin/env python3
"""Plan, apply, or roll back one journaled Pi Web Tools cutover."""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
from typing import Any

from pi_web_profiles import resolve_profiles

UNITS = ["webxd.service", "pi-web-reader.service", "pi-web-searxng.service", "pi-browserd.service", "pi-web-crawl.service", "pi-web-docling.service", "pi-web-egress-proxy.service"]
RUN_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")


def fail(message: str) -> None:
    raise RuntimeError(message)


def digest_tree(root: Path) -> str:
    digest = hashlib.sha256()
    for directory, names, files in os.walk(root, topdown=True, followlinks=False):
        base = Path(directory)
        names[:] = sorted(name for name in names if name != "candidate-manifest.json")
        for name in sorted([*names, *files]):
            path = base / name
            relative = path.relative_to(root).as_posix()
            if relative == "candidate-manifest.json":
                continue
            info = path.lstat()
            digest.update(relative.encode()); digest.update(b"\0")
            digest.update(oct(stat.S_IMODE(info.st_mode)).encode()); digest.update(b"\0")
            if path.is_symlink():
                digest.update(b"L\0"); digest.update(os.readlink(path).encode())
            elif path.is_file():
                digest.update(b"F\0")
                with path.open("rb") as stream:
                    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                        digest.update(chunk)
            elif path.is_dir():
                digest.update(b"D")
            else:
                fail(f"candidate contains an unsupported filesystem entry: {relative}")
            digest.update(b"\0")
    return digest.hexdigest()


def snapshot(path: Path, directory_backup: Path) -> dict[str, Any]:
    if path.is_symlink():
        return {"kind": "symlink", "target": os.readlink(path)}
    if not path.exists():
        return {"kind": "missing"}
    if path.is_dir():
        return {"kind": "directory", "backup": str(directory_backup)}
    if not path.is_file():
        fail(f"managed path is not a file, directory, or symbolic link: {path}")
    return {"kind": "file", "mode": path.stat().st_mode & 0o777, "dataBase64": base64.b64encode(path.read_bytes()).decode("ascii")}


def remove_managed(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def restore_path(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    kind = value["kind"]
    if kind == "directory":
        backup = Path(value["backup"])
        if not backup.is_dir():
            fail(f"directory backup is missing: {backup}")
        remove_managed(path)
        os.replace(backup, path)
        fsync_directory(path.parent)
        if backup.parent != path.parent:
            fsync_directory(backup.parent)
        return
    temporary = path.parent / f".{path.name}.m7-{os.getpid()}"
    remove_managed(temporary)
    if kind == "missing":
        remove_managed(path)
        fsync_directory(path.parent)
        return
    if kind == "symlink":
        os.symlink(value["target"], temporary)
    elif kind == "file":
        temporary.write_bytes(base64.b64decode(value["dataBase64"], validate=True))
        os.chmod(temporary, int(value["mode"]))
    else:
        fail("journal contains an invalid path kind")
    os.replace(temporary, path)
    fsync_directory(path.parent)


def install_path(path: Path, value: dict[str, Any], before: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if before["kind"] == "directory" and path.is_dir() and not path.is_symlink():
        backup = Path(before["backup"])
        backup.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
        if backup.exists():
            fail(f"directory backup already exists: {backup}")
        os.replace(path, backup)
        fsync_directory(path.parent)
        fsync_directory(backup.parent)
    restore_path(path, value)


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_json(path: Path, value: dict[str, Any]) -> None:
    temporary = path.parent / f".{path.name}.tmp-{os.getpid()}"
    with temporary.open("w", encoding="utf-8") as stream:
        stream.write(json.dumps(value, sort_keys=True, indent=2) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
    fsync_directory(path.parent)


def run_systemctl(command: str, args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run([command, "--user", *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if check and result.returncode != 0:
        fail(f"systemctl {' '.join(args)} failed: {(result.stderr or result.stdout).strip()}")
    return result


def service_state(command: str) -> dict[str, dict[str, bool | str]]:
    state: dict[str, dict[str, bool | str]] = {}
    for unit in UNITS:
        active = run_systemctl(command, ["is-active", "--quiet", unit], check=False).returncode == 0
        enabled = run_systemctl(command, ["is-enabled", unit], check=False).stdout.strip()
        state[unit] = {"active": active, "enabled": enabled}
    return state


def restore_services(command: str, state: dict[str, dict[str, Any]]) -> None:
    errors: list[str] = []
    enable_actions = {
        "enabled": ["enable"],
        "enabled-runtime": ["enable", "--runtime"],
        "disabled": ["disable"],
    }
    for unit in UNITS:
        enabled = state[unit]["enabled"]
        # Accept journals from before enable state names were recorded.
        if isinstance(enabled, bool):
            enabled = "enabled" if enabled else "disabled"
        action = enable_actions.get(enabled)
        if action is None:
            continue
        try:
            run_systemctl(command, [*action, unit])
        except (OSError, RuntimeError) as error:
            errors.append(str(error))
    for unit in UNITS:
        try:
            run_systemctl(command, ["start" if state[unit]["active"] else "stop", unit])
        except (OSError, RuntimeError) as error:
            errors.append(str(error))
    if errors:
        fail(f"service restoration failed after all attempts: {'; '.join(errors)}")


def activate_profile(command: str, selected: list[str]) -> None:
    """Apply the selected service set after all profile paths are in place."""
    errors: list[str] = []
    selected_set = set(selected)
    for unit in UNITS:
        try:
            if unit in selected_set:
                if unit != "pi-web-searxng.service":
                    run_systemctl(command, ["enable", unit])
                run_systemctl(command, ["start", unit])
            else:
                run_systemctl(command, ["disable", unit], check=False)
                run_systemctl(command, ["stop", unit], check=False)
        except (OSError, RuntimeError) as error:
            errors.append(str(error))
    if errors:
        fail(f"profile activation failed after all attempts: {'; '.join(errors)}")


def generated(prefix: Path, config: Path, candidate: Path, profile: dict[str, Any]) -> dict[Path, dict[str, Any]]:
    stable = prefix / "lib/pi-web-tools"
    bin_dir = prefix / "bin"
    unit_dir = config / "systemd/user"
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "pi-web"
    browser_enabled = "browser" in profile["resolvedProfiles"]
    documents_enabled = "documents" in profile["resolvedProfiles"]
    browser_path = f"{stable}/.agent-browser/node_modules/.bin:" if browser_enabled else ""
    units = {
        "webxd.service": f"""[Unit]\nDescription=Pi Web authority\nAfter=pi-web-reader.service pi-web-searxng.service\nWants=pi-web-reader.service pi-web-searxng.service\n[Service]\nWorkingDirectory={stable}\nExecStart=/usr/bin/node {stable}/apps/webxd/dist/apps/webxd/src/main.js\nEnvironment=PATH={bin_dir}:/usr/local/bin:/usr/bin\nEnvironment=WEBX_CACHE_DIR={cache}/responses\nEnvironment=WEBX_CRAWL_URL=http://127.0.0.1:8793/\nEnvironment=WEBX_EGRESS_PROXY=http://127.0.0.1:8877/\nRuntimeDirectory=pi-web\nRuntimeDirectoryMode=0700\nRestart=on-failure\n[Install]\nWantedBy=default.target\n""",
        "pi-web-reader.service": f"""[Unit]\nDescription=Pi Web direct reader\nAfter=network-online.target\n[Service]\nWorkingDirectory={stable}/components/browser\nExecStart={stable}/.venv/bin/pi-web-reader\nEnvironment=PI_WEB_READER_HOST=127.0.0.1\nEnvironment=PI_WEB_READER_PORT=8787\nEnvironment=PI_WEB_DOCLING_URL=http://127.0.0.1:8792/\nEnvironment=PI_WEB_DOCUMENTS_ENABLED={'1' if documents_enabled else '0'}\nEnvironment=PYTHONDONTWRITEBYTECODE=1\nMemoryMax={profile['resourceLimits']['pi-web-reader.service']['MemoryMax']}\nTasksMax={profile['resourceLimits']['pi-web-reader.service']['TasksMax']}\nRestart=on-failure\n[Install]\nWantedBy=default.target\n""",
        "pi-browserd.service": f"""[Unit]\nDescription=Pi Web visual browser coordinator\nAfter=network-online.target\n[Service]\nExecStart={stable}/bin/pi-browserd\nEnvironment=PATH={browser_path}{bin_dir}:/usr/local/bin:/usr/bin\nEnvironment=RUST_LOG=pi_browserd=info,pi_web=info\nRestart=on-failure\n[Install]\nWantedBy=default.target\n""",
        "pi-web-docling.service": f"""[Unit]\nDescription=Pi Web document converter\nAfter=network-online.target\n[Service]\nWorkingDirectory={stable}/components/browser\nExecStart={stable}/.venv/bin/pi-web-docling\nEnvironment=PI_WEB_DOCLING_HOST=127.0.0.1\nEnvironment=PI_WEB_DOCLING_PORT=8792\nEnvironment=DOCLING_ARTIFACTS_PATH={cache}/document-models\nEnvironment=HF_HUB_OFFLINE=1\nEnvironment=TRANSFORMERS_OFFLINE=1\nEnvironment=PI_WEB_DOCLING_CONCURRENCY={profile['resourceLimits']['pi-web-docling.service']['Concurrency']}\nEnvironment=PI_WEB_DOCLING_QUEUE_SIZE={profile['resourceLimits']['pi-web-docling.service']['QueueSize']}\nEnvironment=PI_WEB_DOCLING_TIMEOUT_SECONDS={profile['resourceLimits']['pi-web-docling.service']['TimeoutSeconds']}\nEnvironment=PI_WEB_DOCLING_MAX_INPUT_BYTES={profile['resourceLimits']['pi-web-docling.service']['MaxInputBytes']}\nEnvironment=PI_WEB_DOCLING_MAX_OUTPUT_BYTES={profile['resourceLimits']['pi-web-docling.service']['MaxOutputBytes']}\nEnvironment=TMPDIR=/tmp\nEnvironment=PYTHONDONTWRITEBYTECODE=1\nMemoryMax={profile['resourceLimits']['pi-web-docling.service']['MemoryMax']}\nTasksMax={profile['resourceLimits']['pi-web-docling.service']['TasksMax']}\nTemporaryFileSystem=/tmp:rw,size={profile['resourceLimits']['pi-web-docling.service']['MaxTempBytes']},nodev,nosuid,noexec\nRestart=on-failure\n[Install]\nWantedBy=default.target\n""" if documents_enabled else "",
        "pi-web-crawl.service": f"""[Unit]\nDescription=Pi Web bounded Crawl4AI service\nAfter=network-online.target pi-web-egress-proxy.service\nRequires=pi-web-egress-proxy.service\n[Service]\nWorkingDirectory={stable}/components/browser\nExecStart={stable}/.venv/bin/pi-web-crawl\nEnvironment=PI_WEB_CRAWL_HOST=127.0.0.1\nEnvironment=PI_WEB_CRAWL_PORT=8793\nEnvironment=PI_WEB_CRAWL_PROXY=http://127.0.0.1:8877\nEnvironment=PLAYWRIGHT_BROWSERS_PATH={stable}/.playwright-browsers\nEnvironment=PYTHONDONTWRITEBYTECODE=1\nRestart=on-failure\n[Install]\nWantedBy=default.target\n""",
        "pi-web-egress-proxy.service": f"""[Unit]\nDescription=Pi Web connection-bound egress proxy\nAfter=network-online.target\n[Service]\nExecStart=/usr/bin/python3 {stable}/components/browser/scripts/secure_egress_proxy.py\nEnvironment=PI_WEB_EGRESS_HOST=127.0.0.1\nEnvironment=PI_WEB_EGRESS_PORT=8877\nEnvironment=PYTHONDONTWRITEBYTECODE=1\nRestart=on-failure\n[Install]\nWantedBy=default.target\n""",
    }
    workspace = f'exec "{stable}/bin/pi-browser-workspace" "$@"' if browser_enabled else "echo 'pi-web: workspace requires the browser profile' >&2; exit 3"
    status_units = " ".join(unit.removesuffix(".service") for unit in profile["units"])
    cli = f"""#!/usr/bin/env bash\nset -euo pipefail\ncase \"${{1:-}}\" in\n doctor) shift; PI_WEB_INSTALL_ROOT=\"{stable}\" exec /usr/bin/node \"{stable}/scripts/pi-web-doctor.mjs\" \"$@\" ;;\n workspace) shift; {workspace} ;;\n audit) shift; exec /usr/bin/node \"{stable}/scripts/pi-web-audit.mjs\" \"$@\" ;;\n status) exec systemctl --user status {status_units} ;;\n *) echo 'usage: pi-web {{doctor|workspace|audit|status}}' >&2; exit 2 ;;\nesac\n"""
    values: dict[Path, dict[str, Any]] = {
        stable: {"kind": "symlink", "target": str(candidate)},
        Path.home() / ".pi/agent/extensions/pi-web": {"kind": "symlink", "target": str(stable / "apps/pi-webx")},
        bin_dir / "pi-web": {"kind": "file", "mode": 0o755, "dataBase64": base64.b64encode(cli.encode()).decode()},
        bin_dir / "pi-browserd": {"kind": "symlink", "target": str(stable / "bin/pi-browserd")} if browser_enabled else {"kind": "missing"},
        bin_dir / "pi-browser-workspace": {"kind": "symlink", "target": str(stable / "bin/pi-browser-workspace")} if browser_enabled else {"kind": "missing"},
        config / "pi-web/installed-profile.json": {"kind": "file", "mode": 0o600, "dataBase64": base64.b64encode((json.dumps(profile, sort_keys=True, indent=2) + "\n").encode()).decode()},
        unit_dir / "pi-web-searxng.service.d/profile-limits.conf": {"kind": "file", "mode": 0o644, "dataBase64": base64.b64encode(f"[Service]\nMemoryMax={profile['resourceLimits']['pi-web-searxng.service']['MemoryMax']}\nTasksMax={profile['resourceLimits']['pi-web-searxng.service']['TasksMax']}\n".encode()).decode()},
    }
    active_units = set(profile["units"])
    for name, text in units.items():
        values[unit_dir / name] = {"kind": "file", "mode": 0o644, "dataBase64": base64.b64encode(text.encode()).decode()} if name in active_units else {"kind": "missing"}
    return values


def validate_candidate(candidate: Path, evidence_path: Path, test_mode: bool) -> dict[str, Any]:
    manifest = json.loads((candidate / "candidate-manifest.json").read_text(encoding="utf-8"))
    if manifest.get("testNoBuild") is True and not test_mode:
        fail("a no-build test candidate cannot be applied")
    digest = digest_tree(candidate)
    if digest != manifest.get("candidateTreeSha256"):
        fail("candidate tree digest does not match its stage manifest")
    evidence = json.loads(evidence_path.read_text(encoding="utf-8"))
    if evidence.get("ok") is not True or evidence.get("mode") not in ("deterministic", "live"):
        fail("smoke evidence is not successful")
    if not test_mode and (evidence.get("candidateCommit") != manifest.get("commit") or evidence.get("candidateTreeSha256") != digest):
        fail("smoke evidence does not identify this candidate")
    return manifest


def install_signal_traps() -> None:
    def interrupted(signum: int, _frame: Any) -> None:
        raise InterruptedError(f"cutover interrupted by signal {signum}")
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)


def test_safety(paths: list[Path], systemctl: str) -> None:
    home = Path.home().resolve()
    if systemctl == "systemctl" or not Path(systemctl).is_absolute():
        fail("test mode requires an absolute fake --systemctl command")
    for path in paths:
        resolved_parent = path.expanduser().absolute().parent.resolve()
        if not resolved_parent.is_relative_to(home):
            fail(f"test-mode managed path is outside HOME: {path}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--plan", action="store_true")
    mode.add_argument("--apply", action="store_true")
    mode.add_argument("--rollback", metavar="RUN_ID")
    parser.add_argument("--candidate", type=Path)
    parser.add_argument("--evidence", type=Path)
    parser.add_argument("--run-id")
    parser.add_argument("--systemctl", default="systemctl")
    parser.add_argument("--test-mode", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    state_root = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "pi-web/cutovers"

    if args.rollback:
        if not RUN_ID.fullmatch(args.rollback):
            fail("rollback run ID is invalid")
        journal_path = state_root / args.rollback / "journal.json"
        journal = json.loads(journal_path.read_text(encoding="utf-8"))
        if journal.get("status") == "rolled-back":
            print(json.dumps({"ok": True, "mode": "rollback", "runId": args.rollback, "historicalDataDeleted": False, "alreadyRolledBack": True}, sort_keys=True))
            return 0
        if journal.get("status") not in ("prepared", "applied", "apply-failed", "rollback-failed"):
            fail("cutover journal is not rollback eligible")
        if journal.get("testMode"):
            test_safety([Path(raw) for raw in journal["before"]], args.systemctl)
        install_signal_traps()
        current_state = service_state(args.systemctl)
        try:
            active_units = [unit for unit in UNITS if current_state[unit]["active"]]
            if active_units:
                run_systemctl(args.systemctl, ["stop", *active_units])
            affected = set(journal.get("completedPaths", []))
            if journal.get("inProgressPath"):
                affected.add(journal["inProgressPath"])
            for raw, value in journal["before"].items():
                if raw in affected:
                    restore_path(Path(raw), value)
            run_systemctl(args.systemctl, ["daemon-reload"])
            restore_services(args.systemctl, journal["servicesBefore"])
            journal["status"] = "rolled-back"; journal["rolledBackUnix"] = int(time.time())
            journal["inProgressPath"] = None
        except BaseException:
            journal["status"] = "rollback-failed"
            restore_services(args.systemctl, current_state)
            raise
        finally:
            write_json(journal_path, journal)
        print(json.dumps({"ok": True, "mode": "rollback", "runId": args.rollback, "historicalDataDeleted": False}, sort_keys=True))
        return 0

    if args.candidate is None or args.evidence is None:
        fail("--candidate and --evidence are required for plan and apply")
    candidate = args.candidate.resolve(strict=True); evidence = args.evidence.resolve(strict=True)
    manifest = validate_candidate(candidate, evidence, args.test_mode)
    prefix = Path(os.environ.get("PI_WEB_PREFIX", str(Path.home() / ".local"))).expanduser()
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))).expanduser()
    profile = manifest.get("profile")
    if not isinstance(profile, dict) or profile != resolve_profiles(candidate, profile.get("requestedProfiles") if isinstance(profile, dict) else None):
        fail("candidate profile does not match its reviewed manifests")
    if "browser-agentcursor" in profile["resolvedProfiles"]:
        fail("browser-agentcursor requires the immutable Phase 4A pi-webctl installer; legacy cutover is intentionally unavailable")
    desired = generated(prefix, config, candidate, profile)
    run_id = args.run_id or f"cutover-{int(time.time())}-{manifest['commit'][:12]}"
    if not RUN_ID.fullmatch(run_id):
        fail("run ID is invalid")
    plan = {"ok": True, "mode": "apply" if args.apply else "plan", "runId": run_id, "candidate": str(candidate), "commit": manifest["commit"], "treeSha256": manifest["candidateTreeSha256"], "profiles": profile["resolvedProfiles"], "replacementPaths": [str(path) for path in desired], "serviceUnits": profile["units"], "stoppedForTransition": UNITS, "coreIndependentFromOptionalWorkers": True, "historicalDataDeleted": False}
    if args.plan:
        print(json.dumps(plan, sort_keys=True, indent=2)); return 0
    if args.test_mode:
        test_safety([*desired, state_root], args.systemctl)
    run_dir = state_root / run_id
    run_dir.mkdir(parents=True, mode=0o700, exist_ok=False)
    before = {str(path): snapshot(path, run_dir / "directory-backups" / hashlib.sha256(str(path).encode()).hexdigest()) for path in desired}
    states = service_state(args.systemctl)
    journal: dict[str, Any] = {**plan, "status": "prepared", "before": before, "servicesBefore": states, "completedPaths": [], "inProgressPath": None, "createdUnix": int(time.time()), "testMode": args.test_mode}
    journal_path = run_dir / "journal.json"; write_json(journal_path, journal)
    install_signal_traps()
    try:
        # No managed path can change until the aggregate stop succeeds.
        run_systemctl(args.systemctl, ["stop", *UNITS])
        journal["servicesStoppedUnix"] = int(time.time())
        write_json(journal_path, journal)
        for path, value in desired.items():
            raw = str(path)
            journal["inProgressPath"] = raw
            write_json(journal_path, journal)
            install_path(path, value, before[raw])
            journal["completedPaths"].append(raw)
            journal["inProgressPath"] = None
            write_json(journal_path, journal)
            if args.test_mode and os.environ.get("PI_WEB_CUTOVER_TEST_KILL_AFTER_REPLACEMENT") == str(len(journal["completedPaths"])):
                os.kill(os.getpid(), signal.SIGKILL)
        run_systemctl(args.systemctl, ["daemon-reload"])
        activate_profile(args.systemctl, profile["units"])
        journal["status"] = "applied"; journal["appliedUnix"] = int(time.time())
    except BaseException:
        journal["status"] = "apply-failed"
        affected = set(journal["completedPaths"])
        if journal.get("inProgressPath"):
            affected.add(journal["inProgressPath"])
        unrestored: list[str] = []
        for raw, value in before.items():
            if raw not in affected:
                continue
            try:
                restore_path(Path(raw), value)
            except (OSError, RuntimeError, ValueError):
                unrestored.append(raw)
        journal["completedPaths"] = unrestored
        journal["inProgressPath"] = None
        run_systemctl(args.systemctl, ["daemon-reload"], check=False)
        restore_services(args.systemctl, states)
        raise
    finally:
        write_json(journal_path, journal)
    print(json.dumps({**plan, "status": "applied", "rollback": f"{Path(__file__).resolve()} --rollback {run_id}", "journal": str(journal_path)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"pi-web-cutover: {error}", file=sys.stderr)
        raise SystemExit(1)
