#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUTPUT=${1:-/tmp/complete-web-actual-evidence}
PROFILE=${2:-bounded}
[[ "$PROFILE" == smoke || "$PROFILE" == bounded ]] || { echo "complete-web-actual-runtime: profile must be smoke or bounded" >&2; exit 64; }
BROWSERD=${PI_WEB_QUALIFICATION_BROWSERD:-$ROOT/components/browser/target/release/pi-browserd}
AGENT_BROWSER=${PI_WEB_QUALIFICATION_AGENT_BROWSER:-/home/mainpc/.local/bin/agent-browser}
PINCHTAB=${PI_WEB_QUALIFICATION_PINCHTAB:-/home/mainpc/.local/bin/pinchtab}
CHROMIUM=${PI_WEB_QUALIFICATION_CHROMIUM:-/usr/bin/chromium-browser}
RUN_ROOT=$(mktemp -d /tmp/pi-web-complete-actual.XXXXXX)
RUNTIME="$RUN_ROOT/runtime"
CONFIG="$RUN_ROOT/config"
DATA="$RUN_ROOT/data"
CACHE="$RUN_ROOT/cache"
HOME_ROOT="$RUN_ROOT/home"
STAGE="$RUN_ROOT/staged-pi-webx"
IDENTITY="$RUN_ROOT/actual-identity.json"
BROWSER_SOCKET="$RUNTIME/pi-web/browserd.sock"
WEBXD_SOCKET="$RUNTIME/pi-web/webxd.sock"
BROWSER_PID=
WEBXD_PID=
BROWSER_PGID=
WEBXD_PGID=

kill_group() {
  local group=${1:-}
  [[ -n "$group" ]] || return 0
  kill -TERM -- "-$group" 2>/dev/null || true
  for _ in $(seq 1 30); do pgrep -g "$group" >/dev/null || return 0; sleep .1; done
  kill -KILL -- "-$group" 2>/dev/null || true
}

kill_marked_descendants() {
  local marker="$RUN_ROOT"
  for pid in /proc/[0-9]*; do
    [[ -r "$pid/environ" ]] || continue
    if tr '\0' '\n' 2>/dev/null <"$pid/environ" | grep -Fqx "PI_WEB_QUALIFICATION_ROOT=$marker"; then
      kill -TERM "${pid##*/}" 2>/dev/null || true
    fi
  done
  sleep .5
  for pid in /proc/[0-9]*; do
    [[ -r "$pid/environ" ]] || continue
    if tr '\0' '\n' 2>/dev/null <"$pid/environ" | grep -Fqx "PI_WEB_QUALIFICATION_ROOT=$marker"; then
      kill -KILL "${pid##*/}" 2>/dev/null || true
    fi
  done
}

cleanup() {
  set +e
  kill_group "$WEBXD_PGID"
  kill_group "$BROWSER_PGID"
  kill_marked_descendants
  [[ -n "$WEBXD_PID" ]] && wait "$WEBXD_PID" 2>/dev/null || true
  [[ -n "$BROWSER_PID" ]] && wait "$BROWSER_PID" 2>/dev/null || true
  rm -rf "$RUN_ROOT" "$ROOT/apps/webxd/dist"
}
trap cleanup EXIT INT TERM

for binary in "$BROWSERD" "$AGENT_BROWSER" "$PINCHTAB" "$CHROMIUM"; do
  [[ -x "$binary" ]] || { echo "complete-web-actual-runtime: missing executable: $binary" >&2; exit 1; }
done
mkdir -p "$RUNTIME" "$CONFIG/pi-web" "$DATA" "$CACHE" "$HOME_ROOT" "$RUN_ROOT/bin" "$OUTPUT"
chmod 700 "$RUN_ROOT" "$RUNTIME" "$CONFIG" "$DATA" "$CACHE" "$HOME_ROOT" "$RUN_ROOT/bin" "$OUTPUT"
cat >"$RUN_ROOT/bin/pinchtab" <<'SH'
#!/usr/bin/env bash
printf '%q ' "$@" >>"$PI_WEB_PINCHTAB_ARG_LOG"
printf '\n' >>"$PI_WEB_PINCHTAB_ARG_LOG"
exec "$PI_WEB_PINCHTAB_REAL" "$@"
SH
chmod 700 "$RUN_ROOT/bin/pinchtab"

"$ROOT/scripts/pi-package-stage" --source "$ROOT/apps/pi-webx" --output "$STAGE" >"$OUTPUT/package-stage.json"
PACKAGE_SHA=$(python3 - "$STAGE" <<'PY'
import hashlib, pathlib, sys
root=pathlib.Path(sys.argv[1]); digest=hashlib.sha256()
for path in sorted(root.rglob('*'), key=lambda p:p.relative_to(root).as_posix()):
    if path.is_symlink(): raise SystemExit('staged package contains a symlink')
    if path.is_file():
        digest.update(path.relative_to(root).as_posix().encode()); digest.update(b'\0'); digest.update(path.read_bytes()); digest.update(b'\0')
print(digest.hexdigest())
PY
)

cat >"$CONFIG/pi-web/config.toml" <<EOF
workspace_binary = "true"
agent_browser_binary = "$AGENT_BROWSER"
searxng_url = "http://127.0.0.1:9/"
reader_url = "http://127.0.0.1:9/"
[visual_chromium]
executable_path = "$CHROMIUM"
launch_args = ["--headless=new", "--disable-gpu", "--no-first-run", "--no-default-browser-check"]
EOF

export XDG_RUNTIME_DIR="$RUNTIME" XDG_CONFIG_HOME="$CONFIG" XDG_DATA_HOME="$DATA" XDG_CACHE_HOME="$CACHE" HOME="$HOME_ROOT" PI_WEB_QUALIFICATION_ROOT="$RUN_ROOT"
export PI_WEB_PINCHTAB_REAL="$PINCHTAB" PI_WEB_PINCHTAB_ARG_LOG="$OUTPUT/pinchtab-arguments.log"
export PATH="$RUN_ROOT/bin:$(dirname "$AGENT_BROWSER"):/usr/bin:/bin"
setsid "$BROWSERD" --config "$CONFIG/pi-web/config.toml" >"$OUTPUT/browserd.log" 2>&1 & BROWSER_PID=$!; BROWSER_PGID=$BROWSER_PID
for _ in $(seq 1 200); do [[ -S "$BROWSER_SOCKET" ]] && break; kill -0 "$BROWSER_PID" 2>/dev/null || break; sleep .1; done
[[ -S "$BROWSER_SOCKET" ]] || { echo "complete-web-actual-runtime: isolated Browserd did not start" >&2; exit 1; }

pnpm --dir "$ROOT/apps/webxd" build >"$OUTPUT/webxd-build.log" 2>&1
PI_WEB_QUALIFICATION_DESTINATION_AUTHORITY=isolated-loopback-fixtures-v1 BROWSERD_SOCKET="$BROWSER_SOCKET" WEBXD_SOCKET="$WEBXD_SOCKET" setsid node "$ROOT/apps/webxd/dist/apps/webxd/src/qualification-main.js" >"$OUTPUT/webxd.log" 2>&1 & WEBXD_PID=$!; WEBXD_PGID=$WEBXD_PID
for _ in $(seq 1 200); do [[ -S "$WEBXD_SOCKET" ]] && break; kill -0 "$WEBXD_PID" 2>/dev/null || break; sleep .1; done
[[ -S "$WEBXD_SOCKET" ]] || { echo "complete-web-actual-runtime: actual Webxd did not start" >&2; exit 1; }

BROWSERD_SHA=$(sha256sum "$BROWSERD" | cut -d' ' -f1)
WEBXD_SHA=$(sha256sum "$ROOT/apps/webxd/dist/apps/webxd/src/qualification-main.js" | cut -d' ' -f1)
AGENT_SHA=$(sha256sum "$AGENT_BROWSER" | cut -d' ' -f1)
PINCH_SHA=$(sha256sum "$PINCHTAB" | cut -d' ' -f1)

set +e
PI_WEB_PROBE_SOCKET="$WEBXD_SOCKET" PI_WEB_PROBE_PACKAGE="$STAGE" PI_WEB_PROBE_ROOT="$ROOT" PI_WEB_PROBE_STATE="$RUN_ROOT/probe-fixture" node --input-type=module >"$OUTPUT/actual-rpc-proof.json" 2>"$OUTPUT/actual-rpc-proof.error" <<'JS'
const { WebxFacadeClient } = await import(`file://${process.env.PI_WEB_PROBE_PACKAGE}/vendor/sdk/facade.js`);
const { createFixtureServer } = await import(`file://${process.env.PI_WEB_PROBE_ROOT}/components/browser/packages/test-fixtures/src/server.mjs`);
const paths = ["agent-browser/chrome", "pinchtab/chrome"];
const fixture = createFixtureServer({ uploadRoot: process.env.PI_WEB_PROBE_STATE });
await new Promise((resolve, reject) => { fixture.once("error", reject); fixture.listen(0, "127.0.0.1", resolve); });
const fixtureUrl = `http://127.0.0.1:${fixture.address().port}/static`;
const signal = new AbortController().signal;
const client = new WebxFacadeClient(process.env.PI_WEB_PROBE_SOCKET);
const proof = { capabilities: false, agentBrowserCreateClose: false, pinchtabCreateClose: false, paths: {} };
try {
  await client.start({ signal, ownerId: "actual-runtime-probe", cwd: "/deterministic/public-fixtures" });
  const capabilities = await client.capabilities({ signal, ownerId: "actual-runtime-probe" });
  proof.capabilities = capabilities.daemon === "ready" && JSON.stringify(capabilities.browserPathIds) === JSON.stringify(paths);
  for (const pathId of paths) {
    try {
      const opened = await client.request("browser.open", { pathId, url: fixtureUrl }, { signal, ownerId: "actual-runtime-probe", cwd: "/deterministic/public-fixtures", idempotencyKey: `probe-open-${pathId}` });
      if (opened.data.pathId !== pathId) throw new Error(`path identity changed to ${opened.data.pathId}`);
      await client.request("browser.tabs", { action: "close-session", browserSessionId: opened.data.sessionId }, { signal, ownerId: "actual-runtime-probe", cwd: "/deterministic/public-fixtures", idempotencyKey: `probe-close-${pathId}` });
      proof.paths[pathId] = { ok: true };
      if (pathId === paths[0]) proof.agentBrowserCreateClose = true;
      else proof.pinchtabCreateClose = true;
    } catch (error) {
      proof.paths[pathId] = { ok: false, error: String(error?.message ?? error).replace(/Bearer\s+\S+/gi, "Bearer [REDACTED]").slice(0, 500) };
    }
  }
} finally {
  await client.stop({ ownerId: "actual-runtime-probe" }).catch(() => undefined);
  await new Promise((resolve) => fixture.close(resolve));
}
console.log(JSON.stringify(proof, null, 2));
if (!proof.capabilities || !proof.agentBrowserCreateClose || !proof.pinchtabCreateClose) process.exitCode = 2;
JS
PROBE_STATUS=$?
set -e
if [[ $PROBE_STATUS -ne 0 ]]; then
  echo "complete-web-actual-runtime: actual adapter RPC proof failed; shippedEntrypoint remains false" >&2
  cat "$OUTPUT/actual-rpc-proof.json" >&2
  exit 2
fi

python3 - "$IDENTITY" "$PACKAGE_SHA" "$BROWSERD" "$BROWSERD_SHA" "$BROWSER_PID" "$WEBXD_SHA" "$WEBXD_PID" "$WEBXD_SOCKET" "$AGENT_SHA" "$PINCH_SHA" "$OUTPUT/actual-rpc-proof.json" <<'PY'
import json, pathlib, sys
out, package_sha, browserd, browserd_sha, browser_pid, webxd_sha, webxd_pid, socket, agent_sha, pinch_sha, proof = sys.argv[1:]
record={"actual":True,"protocolMajor":2,"packageAggregateSha256":package_sha,"webxdSocket":socket,"rpcProof":json.loads(pathlib.Path(proof).read_text()),"pathIdentities":{"agent-browser/chrome":{"pathId":"agent-browser/chrome","backendVersion":"0.33.1","provider":"chrome","sha256":agent_sha},"pinchtab/chrome":{"pathId":"pinchtab/chrome","backendVersion":"0.15.1","provider":"chrome","sha256":pinch_sha}},"processIdentities":{"browserd":{"pid":int(browser_pid),"path":browserd,"sha256":browserd_sha},"webxd":{"pid":int(webxd_pid),"sha256":webxd_sha}}}
pathlib.Path(out).write_text(json.dumps(record,indent=2,sort_keys=True)+'\n')
PY

cp "$IDENTITY" "$OUTPUT/actual-identity.json"
chmod 600 "$OUTPUT/actual-identity.json"
export PI_WEB_QUALIFICATION_RUNTIME=actual PI_WEB_QUALIFICATION_WEBXD_SOCKET="$WEBXD_SOCKET" PI_WEB_QUALIFICATION_IDENTITY="$IDENTITY"
timeout --signal=TERM --kill-after=10s 600s node "$STAGE/qualification/actual-check.mjs" --profile "$PROFILE" --entrypoint "$STAGE/qualification/bridge.mjs" --package "$STAGE" --source-root "$ROOT" --output "$OUTPUT/qualification"
