{
  "schema_version": "1.0",
  "contract": "https://webx.local/schemas/v1/artifact-commit-intent.json",
  "state_machine": {
    "initial_state": "prepared",
    "allowed_transitions": {
      "prepared": ["renamed", "quarantined"],
      "renamed": ["published", "quarantined"],
      "published": ["completed", "quarantined"],
      "completed": [],
      "quarantined": []
    },
    "terminal_states": ["completed", "quarantined"],
    "terminal_action": "return_existing_without_write"
  },
  "path_policy": {
    "staging_root": "staging/commit-intents",
    "final_roots_by_intent_kind": {
      "visit_receipt": "visits",
      "page_version": "pages",
      "artifact_set": "artifacts",
      "wiki_envelope": "wiki/outbox"
    },
    "quarantine_root": "quarantine/commit-intents"
  },
  "manifest_policy": {
    "expected_files_unique_by": "relative_path",
    "duplicate_path_result": "reject_before_persist_or_recover"
  },
  "candidate_resolution": {
    "staging_valid_final_missing": "rename_staging_then_continue",
    "staging_missing_final_valid": "adopt_final_then_continue",
    "staging_valid_final_valid": "quarantine:AMBIGUOUS_CANDIDATES",
    "staging_invalid_final_invalid": "quarantine:RECOVERY_INVARIANT_VIOLATION"
  },
  "recovery_idempotency": {
    "intent_lookup_key": "idempotency_key",
    "publication_key_template": "commit-intent:{commit_intent_id}",
    "repeat_terminal_result": "return_same_state_and_publication_without_write",
    "forbid_duplicate_effects": [
      "visit_receipt",
      "page_version",
      "artifact",
      "index_projection",
      "wiki_delivery"
    ]
  },
  "quarantine_policy": {
    "reason_field": "quarantine_reason_code",
    "safe_detail_field": "quarantine_safe_detail",
    "safe_detail_max_length": 500,
    "safe_detail_forbids_control_characters": true
  }
}
