{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/error.json",
  "title": "ProblemDetails",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "request_id",
    "retryable"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^WEBX_[A-Z0-9_]+$"
    },
    "detail": {
      "type": "string",
      "maxLength": 4000
    },
    "instance": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "durable_outputs": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/artifactRef"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "rule"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "safe_context": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
