{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/artifact-commit-intent.json",
  "title": "ArtifactCommitIntent",
  "description": "The durable journal record that bridges a verified same-filesystem artifact tree rename and publication of its SQLite facts and outbox rows.",
  "$comment": "Application validation MUST apply semantics/artifact-commit-intent-semantics.json. JSON Schema alone cannot enforce unique expected_files.relative_path values or prior-to-next state transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_intent_id",
    "job_id",
    "intent_kind",
    "idempotency_key",
    "state",
    "staging_relative_path",
    "final_relative_path",
    "manifest_sha256",
    "expected_files",
    "recovery_count",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "commit_intent_id": {
      "$ref": "common.json#/$defs/ulid"
    },
    "job_id": {
      "$ref": "common.json#/$defs/ulid"
    },
    "attempt_id": {
      "$ref": "common.json#/$defs/ulid"
    },
    "intent_kind": {
      "type": "string",
      "enum": ["visit_receipt", "page_version", "artifact_set", "wiki_envelope"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300
    },
    "state": {
      "type": "string",
      "enum": ["prepared", "renamed", "published", "completed", "quarantined"]
    },
    "staging_relative_path": {
      "$ref": "#/$defs/stagingPath"
    },
    "final_relative_path": {
      "$ref": "#/$defs/finalPath"
    },
    "manifest_sha256": {
      "$ref": "common.json#/$defs/sha256"
    },
    "expected_files": {
      "$comment": "Every relative_path MUST be unique. The mandatory semantic validator rejects duplicates before persistence or recovery.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "size_bytes"],
        "properties": {
          "relative_path": {
            "$ref": "#/$defs/safeRelativePath"
          },
          "sha256": {
            "$ref": "common.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "published_reference_type": {
      "type": "string",
      "enum": ["visit", "page_version", "artifact", "wiki_delivery"]
    },
    "published_reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "publication_idempotency_key": {
      "type": "string",
      "pattern": "^commit-intent:[0-9a-hjkmnp-tv-z]{26}$"
    },
    "recovery_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_verified_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "renamed_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "published_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "quarantined_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "quarantine_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/quarantinePath"
      }
    },
    "quarantine_reason_code": {
      "type": "string",
      "enum": [
        "STAGING_MISSING",
        "FINAL_MISSING",
        "HASH_MISMATCH",
        "MANIFEST_MISMATCH",
        "PATH_CONFLICT",
        "AMBIGUOUS_CANDIDATES",
        "UNSAFE_PATH",
        "PUBLICATION_CONFLICT",
        "RECOVERY_INVARIANT_VIOLATION"
      ]
    },
    "quarantine_safe_detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "stagingPath": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^staging/commit-intents/[0-9a-hjkmnp-tv-z]{26}$"
    },
    "finalPath": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:visits|pages|artifacts|wiki/outbox)/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "quarantinePath": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^quarantine/commit-intents/[0-9a-hjkmnp-tv-z]{26}(?:/[A-Za-z0-9._/-]+)?$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"intent_kind": {"const": "visit_receipt"}},
        "required": ["intent_kind"]
      },
      "then": {
        "properties": {"final_relative_path": {"pattern": "^visits/"}}
      }
    },
    {
      "if": {
        "properties": {"intent_kind": {"const": "page_version"}},
        "required": ["intent_kind"]
      },
      "then": {
        "properties": {"final_relative_path": {"pattern": "^pages/"}}
      }
    },
    {
      "if": {
        "properties": {"intent_kind": {"const": "artifact_set"}},
        "required": ["intent_kind"]
      },
      "then": {
        "properties": {"final_relative_path": {"pattern": "^artifacts/"}}
      }
    },
    {
      "if": {
        "properties": {"intent_kind": {"const": "wiki_envelope"}},
        "required": ["intent_kind"]
      },
      "then": {
        "properties": {"final_relative_path": {"pattern": "^wiki/outbox/"}}
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["renamed", "published", "completed"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["renamed_at"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["published", "completed"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": [
          "published_at",
          "published_reference_type",
          "published_reference_id",
          "publication_idempotency_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["completed_at"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "quarantined"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["quarantined_at", "quarantine_paths", "quarantine_reason_code"]
      }
    }
  ]
}
