{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/visit-record.json",
  "title": "VisitRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visit_id",
    "job_id",
    "requested_url",
    "operation",
    "state",
    "network_attempted",
    "started_at",
    "completed_at",
    "receipt_artifact_id",
    "visibility"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "visit_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "crawl_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "parent_visit_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "requested_url": {
      "$ref": "common.json#/$defs/url"
    },
    "normalized_requested_url": {
      "$ref": "common.json#/$defs/url"
    },
    "final_url": {
      "$ref": "common.json#/$defs/url"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "fetch",
        "verify",
        "browser_navigate",
        "crawl_target",
        "watch_check",
        "archive_capture",
        "media_info",
        "document_url"
      ]
    },
    "mode": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "cancelled",
        "policy_denied"
      ]
    },
    "network_attempted": {
      "type": "boolean"
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "redirect_chain": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "$ref": "common.json#/$defs/url"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "location": {
            "$ref": "common.json#/$defs/url"
          },
          "resolved_ip_class": {
            "type": "string"
          }
        }
      }
    },
    "error_code": {
      "type": "string",
      "pattern": "^WEBX_[A-Z0-9_]+$"
    },
    "receipt_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "raw_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "markdown_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/warning"
      }
    }
  }
}
