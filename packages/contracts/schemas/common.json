{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/common.json",
  "title": "WebX common definitions",
  "type": "object",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 8192
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime_type": {
          "type": "string",
          "maxLength": 255
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "secret"
          ]
        }
      }
    },
    "projectionState": {
      "type": "string",
      "enum": [
        "excluded",
        "pending",
        "submitted",
        "succeeded",
        "failed",
        "dead_letter"
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "safe_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
    },
    "jobState": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "running",
        "retry_wait",
        "succeeded",
        "partial",
        "failed",
        "cancelled",
        "dead_letter"
      ]
    }
  }
}
