{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/artifact-result.json",
  "title": "ArtifactResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "job_id",
    "state",
    "execution",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "running",
        "retry_wait",
        "succeeded",
        "partial",
        "failed",
        "cancelled",
        "dead_letter"
      ]
    },
    "visit_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "crawl_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_url": {
          "$ref": "common.json#/$defs/url"
        },
        "final_url": {
          "$ref": "common.json#/$defs/url"
        },
        "local_artifact_id": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
        },
        "redirects": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "common.json#/$defs/url"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "started_at",
        "completed_at",
        "cached"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "maxLength": 100
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "http",
            "browser",
            "adaptive",
            "rag",
            "archive",
            "verify",
            "offline",
            "local"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "cached": {
          "type": "boolean"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "mime_type": {
          "type": "string"
        },
        "charset": {
          "type": "string"
        },
        "content_length": {
          "type": "integer",
          "minimum": 0
        },
        "etag": {
          "type": "string"
        },
        "last_modified": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 4000
        },
        "language": {
          "type": "string",
          "maxLength": 35
        },
        "excerpt": {
          "type": "string",
          "maxLength": 50000
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/artifactRef"
      }
    },
    "index_state": {
      "$ref": "common.json#/$defs/projectionState"
    },
    "wiki_state": {
      "$ref": "common.json#/$defs/projectionState"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "engine-observation.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/warning"
      }
    }
  }
}
