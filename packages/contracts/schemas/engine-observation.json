{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/engine-observation.json",
  "title": "EngineObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "engine",
    "state",
    "started_at",
    "completed_at",
    "accepted",
    "quality"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "engine": {
      "type": "string",
      "maxLength": 100
    },
    "engine_version": {
      "type": "string",
      "maxLength": 200
    },
    "route_kind": {
      "type": "string",
      "enum": [
        "http",
        "browser",
        "adaptive",
        "archive",
        "local"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "final_url": {
      "$ref": "common.json#/$defs/url"
    },
    "accepted": {
      "type": "boolean"
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text_chars": {
          "type": "integer",
          "minimum": 0
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_selectors_present": {
          "type": "boolean"
        },
        "challenge_detected": {
          "type": "boolean"
        },
        "schema_valid": {
          "type": "boolean"
        },
        "main_content_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "screenshot_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "error_code": {
      "type": "string"
    },
    "safe_diagnostics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
