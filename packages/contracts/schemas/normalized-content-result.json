{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webx.local/schemas/v1/normalized-content-result.json",
  "title": "NormalizedContentResult",
  "description": "A strict inert result from an isolated hostile-content worker. Raw or active source content is referenced only as staged evidence and is never embedded in this result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "attempt_id",
    "observation_id",
    "state",
    "source",
    "normalized_markdown",
    "metadata",
    "links",
    "quality",
    "provenance",
    "trust",
    "raw_evidence",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_kind": {
      "const": "normalized_content"
    },
    "attempt_id": {
      "$ref": "common.json#/$defs/ulid"
    },
    "observation_id": {
      "$ref": "common.json#/$defs/ulid"
    },
    "state": {
      "type": "string",
      "enum": ["succeeded", "partial"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_url", "normalized_requested_url", "final_url"],
      "properties": {
        "requested_url": {
          "$ref": "common.json#/$defs/url"
        },
        "normalized_requested_url": {
          "$ref": "common.json#/$defs/url"
        },
        "final_url": {
          "$ref": "common.json#/$defs/url"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "charset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "normalized_markdown": {
      "description": "A daemon-controlled staging handle for UTF-8 LF Markdown. The trusted daemon validates and hashes this inert text but does not parse raw HTML.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handle_id", "slot", "sha256", "size_bytes", "mime_type", "encoding"],
      "properties": {
        "handle_id": {
          "$ref": "common.json#/$defs/ulid"
        },
        "slot": {
          "const": "normalized_markdown"
        },
        "sha256": {
          "$ref": "common.json#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "mime_type": {
          "const": "text/markdown"
        },
        "encoding": {
          "const": "utf-8"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "word_count", "character_count"],
      "properties": {
        "title": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "description": {
          "type": ["string", "null"],
          "maxLength": 10000
        },
        "authors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "language": {
          "type": ["string", "null"],
          "maxLength": 35
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "modified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "character_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "url", "same_origin", "nofollow"],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "$ref": "common.json#/$defs/url"
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "rel": {
            "type": "string",
            "maxLength": 1000
          },
          "same_origin": {
            "type": "boolean"
          },
          "nofollow": {
            "type": "boolean"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "challenge_detected", "schema_valid"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "main_content_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "challenge_detected": {
          "type": "boolean"
        },
        "schema_valid": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "engine", "engine_version", "extractor_chain", "sanitizer_version", "normalizer_version"],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "extractor_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "sanitizer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "trust": {
      "const": "untrusted_external_source"
    },
    "security_labels": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,79}$"
      }
    },
    "raw_evidence": {
      "description": "Staged raw evidence handles. These bytes can be retained or quarantined but are not trusted-daemon parse input.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle_id", "slot", "sha256", "size_bytes", "mime_type"],
        "properties": {
          "handle_id": {
            "$ref": "common.json#/$defs/ulid"
          },
          "slot": {
            "type": "string",
            "enum": ["raw_response", "rendered_html", "source_document", "screenshot", "trace"]
          },
          "sha256": {
            "$ref": "common.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mime_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.json#/$defs/warning"
      }
    }
  }
}
