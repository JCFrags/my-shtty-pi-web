{
  "name": "@webx/browserd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/server.ts",
  "bin": { "browserd": "./src/main.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/server.test.ts",
    "test:live": "tsx tests/live-verification.ts",
    "test:soak": "tsx tests/resource-soak.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@webx/browser-protocol": "workspace:*",
    "typebox": "1.3.7",
    "@webx/browser-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
