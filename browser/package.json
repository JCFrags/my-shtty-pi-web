{
  "name": "terminal-browser",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "bash ../scripts/fetch-electron.sh && bash ../scripts/copy-react-grab.sh",
    "build": "tsc -p tsconfig.json",
    "build:engine": "pnpm --filter pixel-react build",
    "start": "pnpm build:engine && pnpm build && pnpm --filter terminal-browser-cli build && exec node ../cli/dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "agentcursor": "git+https://github.com/kumard3/agentcursor.git#b23c633c66fd240f836f5edd1034f6fcf678e237",
    "pixel-react": "workspace:*",
    "pixel-store": "workspace:*",
    "pixel-terminals": "workspace:*",
    "react": "^18.3.1",
    "react-grab": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "electron": "43.3.0",
    "typescript": "^5.5.0"
  }
}
