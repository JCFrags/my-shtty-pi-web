{
  "name": "pi-web-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && node --test scripts/*.test.mjs",
    "test:python": "cd components/browser && uv run --offline pytest tests/reader tests/docling benchmarks/extraction/tests",
    "benchmark:extraction": "cd components/browser && uv run --offline python benchmarks/extraction/run.py",
    "test:extraction": "cd components/browser && uv run --offline python benchmarks/extraction/generate_fixtures.py --check && uv run --offline pytest benchmarks/extraction/tests && uv run --offline python benchmarks/extraction/run.py",
    "test:live": "pnpm --filter @webx/pi-webx exec tsx ../../scripts/live-web-acceptance.ts",
    "test:browser-core": "pnpm --filter @webx/browser-protocol test && pnpm --filter @webx/browser-runtime test && pnpm --filter @webx/browserd test",
    "test:browser-live": "pnpm --filter @webx/browserd test:live",
    "test:browser-soak": "pnpm --filter @webx/browserd test:soak",
    "check:schemas": "pnpm --filter @webx/browser-protocol schema:check && pnpm --filter @webx/workspace-protocol schema:check",
    "test:install-profiles": "node --test scripts/install-contract.test.mjs scripts/m9-profile-contract.test.mjs",
    "build:tauri-frontend": "pnpm --filter @pi-web/workspace build",
    "check:tauri": "cd components/browser && cargo check -p pi-browser-workspace",
    "check:supply-chain": "pnpm licenses list --prod --json | node scripts/release-supply-chain-check.mjs",
    "check:release-builder": "tsc --allowJs --checkJs --noEmit --module nodenext --moduleResolution nodenext --target es2024 --types node --strict scripts/phase4a-release.mjs scripts/pi-webctl.mjs",
    "test:release-builder": "node --test scripts/phase4a-release.test.mjs",
    "release:build": "node scripts/phase4a-release.mjs build",
    "release:verify": "node scripts/phase4a-release.mjs verify",
    "release:reproducibility": "node scripts/phase4a-release.mjs reproducibility",
    "check:rust": "cd components/browser && cargo check --workspace --locked",
    "test:rust": "cd components/browser && cargo test --workspace --locked"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mozilla/readability": "0.6.0",
    "@types/node": "24.12.4",
    "@types/turndown": "5.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "defuddle": "0.19.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "linkedom": "0.18.13",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
