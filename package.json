{
  "name": "pi-web-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:python": "cd components/browser && uv run pytest tests/reader tests/docling",
    "test:live": "pnpm --filter @webx/pi-webx exec tsx ../../scripts/live-web-acceptance.ts",
    "check:rust": "cd components/browser && cargo check --workspace",
    "test:rust": "cd components/browser && cargo test --workspace"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
