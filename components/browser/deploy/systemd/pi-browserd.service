[Unit]
Description=Pi Web Workspace coordinator
After=network-online.target pi-web-reader.service
Wants=network-online.target pi-web-reader.service

[Service]
Type=simple
ExecStart=%h/.local/bin/pi-browserd
Restart=on-failure
RestartSec=1
Environment=RUST_LOG=pi_browserd=info,pi_web=info
Environment=LIGHTPANDA_DISABLE_TELEMETRY=true
# WebKitGTK currently crashes on this Fedora/Wayland stack; XWayland is stable.
Environment=GDK_BACKEND=x11
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
EnvironmentFile=-%h/.config/pi-web/visual-browser.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
