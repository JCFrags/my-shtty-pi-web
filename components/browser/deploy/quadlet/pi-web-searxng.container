[Unit]
Description=Pi Web Workspace local SearXNG
After=network-online.target
Wants=network-online.target

[Container]
Image=__SEARXNG_IMAGE__
ContainerName=pi-web-searxng
PublishPort=127.0.0.1:8888:8080
Volume=%h/.config/pi-web/searxng:/etc/searxng:Z
Environment=SEARXNG_BASE_URL=http://127.0.0.1:8888/
NoNewPrivileges=true

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
