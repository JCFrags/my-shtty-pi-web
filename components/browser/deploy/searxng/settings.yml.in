use_default_settings: true

server:
  bind_address: "0.0.0.0"
  port: 8080
  secret_key: "__SEARXNG_SECRET__"
  limiter: false
  image_proxy: false

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "auto"
  formats:
    - html
    - json

# Keep ordinary web search simple. DuckDuckGo's JSON-backed web engine is the
# primary general engine. The default HTML engine and other frequently blocked
# scraper engines are disabled so their CAPTCHA failures cannot remove recall.
# Bing remains a low-weight fallback when the primary engine is unavailable.
engines:
  - name: duckduckgo
    disabled: true
  - name: duckduckgo web
    disabled: false
    weight: 2.0
  - name: bing
    engine: bing
    disabled: false
    weight: 0.25
  - name: brave
    disabled: true
  - name: google cse
    disabled: true
  - name: startpage
    disabled: true
  - name: github
    engine: github
    disabled: false

ui:
  static_use_hash: true

outgoing:
  request_timeout: 10.0
  max_request_timeout: 20.0
  pool_connections: 100
  pool_maxsize: 20
