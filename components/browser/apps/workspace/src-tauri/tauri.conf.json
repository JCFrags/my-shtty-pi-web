{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Browser Workspace",
  "version": "0.1.0",
  "identifier": "dev.pi-web.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Pi Browser Workspace",
      "width": 1440,
      "height": 920,
      "minWidth": 960,
      "minHeight": 640,
      "visible": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "One live browser workspace for local Pi agents"
  }
}
