{
  "name": "@pi-web/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "test": "node --test test/*.test.mjs && vitest run test/*.test.ts",
    "test:binary-ipc": "cargo test --manifest-path src-tauri/Cargo.toml probe::tests::produces_one_hundred_unique_one_megabyte_payload_digests && node --test test/security.test.mjs",
    "test:input-ipc": "vitest run test/input-ipc.test.ts && cargo test --manifest-path src-tauri/Cargo.toml protocol::tests::bounds_typed_human_input_records",
    "test:release-arguments": "cargo test --release --manifest-path src-tauri/Cargo.toml window::tests::accepts_only_bounded_fixed_launch_arguments",
    "test:live": "pnpm --filter @webx/webxd test:workspace-live",
    "test:soak": "pnpm --filter @webx/webxd test:workspace-soak",
    "check": "tsc -b",
    "format": "true"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "typescript": "5.9.3",
    "vite": "7.0.6",
    "vitest": "4.1.10"
  }
}
