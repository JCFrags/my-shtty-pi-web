    "check": "tsc -b",
    "format": "true"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "typescript": "5.9.3",
    "vite": "7.0.6",
    "vitest": "4.1.10"
  }
}
