{
  "name": "@pi-web/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "test": "node --test test/*.test.mjs && vitest run test/*.test.ts",
